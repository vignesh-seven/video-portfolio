---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  platform: "youtube" | "instagram";
  playbackID: string;
  externalID: string;
  category: string;
  viewCount?: string;
  index: number;
  thumbnailTime?: string;
}

const {
  title,
  platform,
  playbackID,
  externalID,
  category,
  viewCount = "0 viewCount",
  index,
  thumbnailTime,
} = Astro.props;

// Compute embed URLs
// const embedUrl =
//   platform === "youtube"
//     ? `https://www.youtube.com/embed/${playbackID}?autoplay=1&mute=1&controls=0`
//     : `https://www.instagram.com/reel/${playbackID}/embed`;

const externalUrl =
  platform === "youtube"
    ? `https://www.youtube.com/shorts/${externalID}`
    : `https://www.instagram.com/reel/${externalID}/`;

// Fallback to Mux test video ID if current ID is a YT/IG ID (11 chars)
const fallbackPlaybackId = "DS00SgA1yBeMI02ypS5T00DT5779adA500Ad";
const playbackId = playbackID.length === 11 ? fallbackPlaybackId : playbackID;

const paddedIndex = String(index).padStart(2, "0");
---

<div class="video-card">
  <!-- Card Top Slate -->
  <div class="card-header">
    <span class="mono-label">REEL_{paddedIndex}</span>
    <div class="header-dots">
      <span class="status-indicator"></span>
      <span class="mono-label">{viewCount}</span>
    </div>
  </div>

  <!-- Video Embed Container -->
  <div class="video-container">
    <mux-player
      playback-id={playbackId}
      stream-type="on-demand"
      metadata-video-title={title}
      muted
      playsinline
      thumbnail-time={thumbnailTime}></mux-player>
  </div>

  <!-- Card Footer Details -->
  <div class="card-footer">
    <h4 class="video-title">{title}</h4>
    <div class="footer-meta">
      <span class="category-badge">{category}</span>
      <!-- <span class="platform-label"
        >{platform === "youtube" ? "YT_SHORTS" : "IG_REEL"}</span
      > -->
      <a
        href={externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="open-link-in-new-tab"
        href={externalUrl}
        aria-label={`Open ${platform} video in new tab`}
      >
          <Icon size="1.5rem" name="arrow-up-right-from-square" />
      </a>
    </div>
  </div>
</div>
<script>
  import "@mux/mux-player";

  document.querySelectorAll(".video-container").forEach(function (container) {
    const player = container.querySelector("mux-player");
    if (!player) return;

    // container.addEventListener("mouseenter", function () {
    //   player.volume = 0.4;
    //   player.muted = false;
    //   player.style.filter = "grayscale(0%)";
    // });
    // container.addEventListener("mouseleave", function () {
    //   player.volume = 0.4;
    //   player.muted = true;
    //   player.style.filter = "grayscale(100%)";
    // });
  });
</script>
<style>
  .video-card {
    background-color: var(--card-bg);
    border: var(--border-width) solid var(--border-color);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.2s ease-out,
      box-shadow 0.2s ease-out;
    box-shadow: 0 0 0 var(--border-color);
  }

  .video-card:hover {
    /* transform: translate(-4px, -4px); */
    box-shadow: 0 0 0 0.25em var(--border-color);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-bottom: var(--border-width) solid var(--border-color);
    font-size: 0.75rem;
    background-color: var(--bg-color);
  }

  .header-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    background-color: var(--accent-color);
    border-radius: 50%;
  }

  .video-container {
    position: relative;
    width: 100%;
    /* 9:16 vertical ratio */
    aspect-ratio: 9 / 16;
    background-color: #000;
    overflow: hidden;
  }

  .video-container mux-player {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    --media-object-fit: cover;
    --media-object-position: center;
    /* filter: grayscale(100%); */
    /* transition: filter 0.2s ease-out; */

    /* Theme colors matching project tokens */
    --media-accent-color: var(--accent-color);
    --media-primary-color: var(--text-color);
    --media-secondary-color: var(--card-bg);
    --controls-backdrop-color: transparent;

    /* Control customizations to show only play, volume, seek bar */
    --top-controls: none;
    --center-controls: "play";
    --fullscreen-button: none;
    --picture-in-picture-button: none;
    --captions-button: none;
    --airplay-button: none;
    --cast-button: none;
    --playback-rate-button: none;
    --settings-menu: none;
    --time-display: none;
    --duration-display: none;
    --seek-backward-button: none;
    --seek-forward-button: none;

    --media-object-fit: contain;
  }

  .card-footer {
    padding: 0.75rem;
    border-top: var(--border-width) solid var(--border-color);
    background-color: var(--bg-color);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .video-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--text-color);
    text-transform: uppercase;
    word-break: break-word;
  }

  .footer-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .category-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    background-color: var(--pastel-green);
    color: var(--badge-text-color);
    padding: 0.2rem 0.5rem;
    border: var(--border-width) solid var(--border-color);
  }

  .platform-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    /* opacity: 0.7; */
    font-weight: bold;
  }

  .open-link-in-new-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.2rem;
    /* border: var(--border-width) solid var(--border-color); */
    /* font-size: 2rem; */
  }

  .open-link-in-new-tab:hover {
  }
</style>
