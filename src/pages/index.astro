---

<Layout title="Vignesh | Video Editor Portfolio">
  <!-- SECTION 1: HERO SECTION -->
  <section id="hero" class="hero-section">
    <!-- Left: Text content -->
    <div class="hero-content">
      <!-- Simplified hero header -->

      <div class="hero-main">
        <h1 class="hero-name">VIGNESH TIRUPATHI</h1>
        <p class="hero-tagline">
          Creative Associate, Video Editor from Nellore, India.
        </p>

        <div class="hero-skills-group">
          <span class="skills-title mono-label">SKILL_SET:</span>
          <div class="skills-list">
            <span class="skill-tag">SHORT-FORM_VIDEOS</span>
            <span class="skill-tag">LONG-FORM_VIDEOS</span>
            <span class="skill-tag">MOTION_GRAPHICS</span>
            <span class="skill-tag">SOUND_DESIGN</span>
            <span class="skill-tag">BRAND_STRATEGY</span>
          </div>
        </div>
      </div>

      <div class="hero-meta-footer">
        <a href="#best-works" class="btn-flat">VIEW_PORTFOLIO</a>
        <span>
          <a href="https://wa.me/917901390532" class="btn-flat" aria-label={`Link to WhatsApp Chat`} target="_blank"
            ><Icon size="1.2rem" name="mdi:whatsapp" /></a
          >
          <a href="https://www.instagram.com/vignesh__tpt/" class="btn-flat" aria-label={`Link to Instagram`} target="_blank"
            ><Icon size="1.2rem" name="mdi:instagram" /></a
          >
          <a href="mailto:vignesh77024@gmail.com" class="btn-flat" aria-label={`Link to Email`} target="_blank"
            ><Icon size="1.2rem" name="mdi:email" /></a
          >
        </span>
      </div>
    </div>

    <!-- Right: Artwork/Photo -->
    <div class="hero-artwork-col">
      <div class="artwork-viewfinder">
        <div class="viewfinder-corner top-left"></div>
        <div class="viewfinder-corner top-right"></div>
        <div class="viewfinder-corner bottom-left"></div>
        <div class="viewfinder-corner bottom-right"></div>

        <Image
          src="/video_editor_artwork.jpg"
          alt="Analog Video Editor Graphic Artwork"
          class="artwork-image"
		  loading="eager"
          width={1024}
          height={1024}
        />
        <div class="artwork-label">
          <span class="mono-label">CAM_A // SHOT_01</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BEST WORKS SECTION -->
  <section id="best-works" class="works-section">
    <div class="section-banner">
      <h2 class="section-title">Best Works</h2>
    </div>

    <div class="works-container">
      <!-- Primary Grid (4 items in a row) -->
      <div class="works-grid">
        {
          primaryWorks.map((work, idx) => (
            <VideoCard
              title={work.title}
              platform={work.platform}
              playbackID={work.playbackID}
              externalID={work.externalID}
              category={work.category}
              viewCount={work.viewCount}
              index={idx + 1}
              thumbnailTime={work.thumbnailTime}
            />
          ))
        }
      </div>

      <!-- Secondary Expandable Grid (4 items) -->
      <div
        id="expanded-works-grid"
        class="works-grid collapsible-grid collapsed"
      >
        {
          secondaryWorks.map((work, idx) => (
            <VideoCard
              title={work.title}
              platform={work.platform}
              playbackID={work.playbackID}
              externalID={work.externalID}
              category={work.category}
              viewCount={work.viewCount}
              index={idx + 5}
              thumbnailTime={work.thumbnailTime}
            />
          ))
        }
      </div>

      <!-- Expand Toggle Button -->
      <div class="expand-btn-wrapper">
        <button id="toggle-works-btn" class="btn-flat">
          [ ALL WORKS // EXPAND ]
        </button>
      </div>
    </div>
  </section>

  <!-- SECTION 3: EXPERIENCE TIMELINE -->
  <section id="experience" class="experience-section">
    <div class="section-banner">
      <h2 class="section-title">Experience</h2>
    </div>

    <div class="timeline-container">
      {
        experiences.map((exp) => (
          <TimelineItem
            year={exp.year}
            role={exp.role}
            company={exp.company}
            description={exp.description}
            tag={exp.tag}
          />
        ))
      }
    </div>
  </section>
</Layout>

<script>
  function setupToggle() {
    const toggleBtn = document.getElementById("toggle-works-btn");
    const expandedGrid = document.getElementById("expanded-works-grid");

    if (!toggleBtn || !expandedGrid) return;

    toggleBtn.addEventListener("click", () => {
      const isCollapsed = expandedGrid.classList.contains("collapsed");

      if (isCollapsed) {
        expandedGrid.classList.remove("collapsed");
        toggleBtn.textContent = "[ SHOW LESS // COLLAPSE ]";
      } else {
        expandedGrid.classList.add("collapsed");
        toggleBtn.textContent = "[ ALL WORKS // EXPAND ]";

        // Smoothly scroll back to the works section header so the user doesn't get disoriented
        document
          .getElementById("best-works")
          ?.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  // Setup on script load and after view transitions
  setupToggle();
  document.addEventListener("astro:after-swap", setupToggle);
</script>

<style>
  /* SECTION 1: HERO */
  .hero-section {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    min-height: 60vh;
    border-bottom: var(--border-width) solid var(--border-color);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5rem;
    border-right: var(--border-width) solid var(--border-color);
  }

  .hero-meta-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    opacity: 0.8;
    font-size: 0.8rem;
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: 1rem;
  }

  .status-badge {
    background-color: var(--pastel-green);
    color: #1a1a1a;
    padding: 0.15rem 0.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border: 1px solid var(--border-color);
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem 0;
  }

  .hero-name {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--text-color);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hero-tagline {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    max-width: 600px;
    color: var(--text-color);
    opacity: 0.95;
    font-family: var(--font-mono);
    /* text-transform: uppercase; */
  }

  .hero-skills-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .skills-title {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.6rem;
    color: var(--text-color);
  }

  .hero-meta-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* border-top: 1px dashed var(--border-color); */
    padding-top: 1.5rem;
    min-width: max-content;
  }

  /* Artwork Column */
  .hero-artwork-col {
    background-color: var(--card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    position: relative;
  }

  .artwork-viewfinder {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    border: 1px solid var(--border-color);
    position: relative;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-color);
    box-shadow: 6px 6px 0px var(--border-color);
  }

  .artwork-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: var(--border-width) solid var(--border-color);
    filter: contrast(1.1) grayscale(0.2);
  }

  /* Viewfinder focus crop corners */
  .viewfinder-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border: var(--border-width) solid var(--border-color);
  }

  .top-left {
    top: 8px;
    left: 8px;
    border-right: none;
    border-bottom: none;
  }

  .top-right {
    top: 8px;
    right: 8px;
    border-left: none;
    border-bottom: none;
  }

  .bottom-left {
    bottom: 8px;
    left: 8px;
    border-right: none;
    border-top: none;
  }

  .bottom-right {
    bottom: 8px;
    right: 8px;
    border-left: none;
    border-top: none;
  }

  .artwork-label {
    position: absolute;
    bottom: -1.25rem;
    left: 0.5rem;
    background-color: var(--bg-color);
    padding: 0 0.5rem;
    border: 1px solid var(--border-color);
    font-size: 0.7rem;
  }

  /* SECTION BANNERS */
  .section-banner {
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: var(--border-width) solid var(--border-color);
    padding: 1rem 1.5rem;
    background-color: var(--bg-color);
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--text-color);
  }

  /* SECTION 2: BEST WORKS */
  .works-section {
    border-bottom: var(--border-width) solid var(--border-color);
  }

  .works-container {
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    width: 100%;
  }

  /* Collapsible Grid Logic */
  .collapsible-grid {
    max-height: 2000px;
    /* overflow: hidden; */
    transition:
      max-height 0.4s steps(8),
      opacity 0.3s ease,
      margin-top 0.3s ease;
    opacity: 1;
  }

  .collapsible-grid.collapsed {
    max-height: 0;
    opacity: 0;
    margin-top: -2rem;
    pointer-events: none;
  }

  .expand-btn-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  /* SECTION 3: EXPERIENCE */
  .experience-section {
    background-color: var(--bg-color);
  }

  .timeline-container {
    max-width: 1200px;
    margin: 0 auto;
    border-left: var(--border-width) solid var(--border-color);
    border-right: var(--border-width) solid var(--border-color);
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-content {
      border-right: none;
      border-bottom: var(--border-width) solid var(--border-color);
      padding: 1.5rem;
    }

    .hero-main {
      padding: 1.5rem 0;
    }

    .hero-artwork-col {
      padding: 2rem;
    }

    .works-container {
      padding: 2rem 1rem;
    }

    .works-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .timeline-container {
      border-left: none;
      border-right: none;
    }
  }
  @media (max-width: 500px) {
	.hero-meta-footer {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

  }
</style>
