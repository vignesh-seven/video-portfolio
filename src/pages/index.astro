---
import Layout from "../layouts/Layout.astro";
import VideoCard from "../components/VideoCard.astro";
import TimelineItem from "../components/TimelineItem.astro";
import Image from "astro/components/Image.astro";

// Video Data Lists
const primaryWorks = [
	{
