---
import { Icon } from 'astro-icon/components';

interface Props {
	title?: string;
}

const { title = "Analog Portfolio - Video Editor" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Google Fonts: Plus Jakarta Sans -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- Camera Viewfinder Overlay Header -->
		<header class="viewfinder-header">
			<div class="viewfinder-top">
				<div class="rec-indicator">
					<Icon size="0.9rem" name="mdi:cursor-default" />
					<Icon size="0.9rem" name="mdi:content-cut" />
					<!-- <Icon size="0.9rem" name="mdi:magnet" /> -->
					<!-- <Icon size="0.9rem" name="mdi:link-variant" /> -->
					<Icon size="0.9rem" name="mdi:format-text" />
					<!-- <span class="rec-dot"></span>
					<span class="viewfinder-stat">REC</span> -->
				</div>
				<div class="timecode-display">
					<span class="viewfinder-stat">TC</span>
					<span id="ticking-timecode" class="viewfinder-stat"
						>01:25:40:00</span
					>
				</div>
				<div class="camera-info">
					<span class="viewfinder-stat">24FPS</span>
					<!-- <span class="viewfinder-stat">ISO 400</span> -->
					<div class="battery-status">
						<!-- <span class="viewfinder-stat">88%</span> -->
						<div class="battery-icon">
							<div class="battery-level"></div>
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- Main Workspace Content -->
		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="viewfinder-footer">
			<div class="footer-content">
				<div class="footer-left">
					<span class="mono-label">© 2026 Vignesh Tirupathi</span>
					<span class="mono-label">ALL RIGHTS RESERVED</span>
				</div>
				<!-- <div class="footer-right">
					<ul class="social-links">
						<li>
							<a
								href="https://instagram.com"
								target="_blank"
								rel="noopener noreferrer"
								class="social-link">INSTAGRAM</a
							>
						</li>
						<li>
							<a
								href="https://youtube.com"
								target="_blank"
								rel="noopener noreferrer"
								class="social-link">YOUTUBE</a
							>
						</li>
						<li>
							<a
								href="https://linkedin.com"
								target="_blank"
								rel="noopener noreferrer"
								class="social-link">LINKEDIN</a
							>
						</li>
						<li>
							<a
								href="mailto:editor@example.com"
								class="social-link">EMAIL</a
							>
						</li>
					</ul>
				</div> -->
			</div>
		</footer>

		<!-- Timecode ticking script -->
		<script>
			function initTimecode() {
				const timecodeEl = document.getElementById("ticking-timecode");
				if (!timecodeEl) return;

				let hours = 1;
				let minutes = 25;
				let seconds = 40;
				let frames = 0;

				setInterval(() => {
					frames++;
					if (frames >= 24) {
						frames = 0;
						seconds++;
						if (seconds >= 60) {
							seconds = 0;
							minutes++;
							if (minutes >= 60) {
								minutes = 0;
								hours++;
								if (hours >= 24) {
									hours = 0;
								}
							}
						}
					}

					const pad = (num: number) => String(num).padStart(2, "0");
					timecodeEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}:${pad(frames)}`;
				}, 1000 / 24); // 24 fps timecode ticking
			}

			// Run on load and after page transitions (Astro view transitions support if added later)
			initTimecode();
			document.addEventListener("astro:after-swap", initTimecode);
		</script>
	</body>
</html>

<style is:global>
	/* Design Tokens & CSS Variables */
	:root {
		/* Light Mode Colors (vibrant pastels, high-contrast borders) */
		--bg-color: #f7f4eb; /* warm cream background */
		--text-color: #0d0e10; /* deep charcoal text */
		--border-color: #0d0e10; /* solid deep charcoal borders */
		--card-bg: #efebe0; /* slightly darker cream for elements */
		--accent-color: #d65538; /* vibrant rust orange */
		--pastel-green: #378a53; /* vibrant deep forest green */
		--pastel-yellow: #e8a72a; /* vibrant mustard gold */
		--pastel-blue: #3d7ea6; /* vibrant steel blue */
		--badge-text-color: #ffffff; /* white text on green badge for light mode */
		--font-sans: "Plus Jakarta Sans", sans-serif;
		--font-mono: "Plus Jakarta Sans", sans-serif;
		--border-width: 2px;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* Dark Mode Colors (vibrant desaturated, dark charcoal background) */
			--bg-color: #0d0e10; /* deep charcoal background */
			--text-color: #f0f0ed; /* bright off-white text */
			--border-color: #f0f0ed; /* solid bright off-white borders */
			--card-bg: #17191b; /* slightly lighter charcoal for elements */
			--accent-color: #e66a4e; /* vibrant copper */
			--pastel-green: #4cb879; /* vibrant green */
			--pastel-yellow: #f2ba49; /* vibrant gold */
			--pastel-blue: #52a1cc; /* vibrant sky blue */
			--badge-text-color: #0d0e10; /* black text on green badge for dark mode */
		}
	}

	/* Reset and Core Layout */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		background-color: var(--bg-color);
		color: var(--text-color);
		font-family: var(--font-mono);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		transition:
			background-color 0.3s ease,
			color 0.3s ease;
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow-x: hidden;
	}

	main {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Global Typography */
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-sans);
		font-weight: 800;
		text-transform: uppercase;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	p {
		line-height: 1.6;
		font-family: var(--font-mono);
		font-size: 0.95rem;
	}

	/* Common Utility UI Classes */
	.mono-label {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.btn-flat {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.25rem;
		font-family: var(--font-mono);
		font-size: 1.05rem;
		font-weight: 500;
		text-transform: uppercase;
		background-color: transparent;
		color: var(--text-color);
		border: var(--border-width) solid var(--border-color);
		cursor: pointer;
		transition: all 0.2s steps(4);
		position: relative;
		margin-right: 0.6rem;
	}

	.btn-flat:hover {
		background-color: var(--text-color);
		color: var(--bg-color);
	}

	.btn-flat:active {
		transform: translate(2px, 2px);
	}

	/* Header Viewfinder Styling */
	.viewfinder-header {
		width: 100%;
		border-bottom: var(--border-width) solid var(--border-color);
		background-color: var(--bg-color);
		z-index: 100;
		position: sticky;
		top: 0;
	}

	.viewfinder-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1.5rem;
		opacity: 0.85;
		font-size: 0.8rem;
		font-family: monospace;
	}

	.viewfinder-stat {
		font-family: monospace;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.rec-indicator {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.rec-dot {
		width: 10px;
		height: 10px;
		background-color: #ff0000;
		border-radius: 50%;
		animation: rec-blink 1s infinite steps(1);
	}

	.camera-info {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.battery-status {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.battery-icon {
		width: 20px;
		height: 10px;
		border: 1px solid var(--border-color);
		padding: 1px;
		position: relative;
	}

	.battery-icon::after {
		content: "";
		position: absolute;
		right: -3px;
		top: 2px;
		width: 2px;
		height: 4px;
		background-color: var(--border-color);
	}

	.battery-level {
		width: 75%;
		height: 100%;
		background-color: var(--pastel-green);
	}

	/* Footer Viewfinder Styling */
	.viewfinder-footer {
		width: 100%;
		margin-top: auto;
		background-color: var(--bg-color);
		border-top: var(--border-width) solid var(--border-color);
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.social-links {
		display: flex;
		list-style: none;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.social-link {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
	}

	.social-link:hover {
		border-bottom-color: var(--border-color);
	}

	/* Animations */
	@keyframes rec-blink {
		0% {
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
		0% {
			opacity: 0;
		}
	}

	/* Scrollbar Styling */
	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: var(--bg-color);
		border-left: var(--border-width) solid var(--border-color);
	}

	::-webkit-scrollbar-thumb {
		background: var(--border-color);
		border: 2px solid var(--bg-color);
	}

	/* Media Queries */
	@media (max-width: 768px) {
		.viewfinder-top {
			padding: 0.5rem 1rem;
		}
		.camera-info {
			gap: 0.75rem;
		}
		.navigation-bar {
			padding: 0.75rem 1rem;
			flex-direction: column;
			gap: 0.75rem;
		}
		.footer-content {
			padding: 1rem;
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
