---
interface Props {
	title?: string;
}

const { title = "Analog Portfolio - Video Editor" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Google Fonts: Courier Prime and Plus Jakarta Sans -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<!-- Camera Viewfinder Overlay Header -->
		<header class="viewfinder-header">
			<div class="viewfinder-top">
				<div class="rec-indicator">
					<span class="rec-dot"></span>
					<span class="mono-label">REC</span>
				</div>
				<div class="timecode-display">
					<span class="mono-label">TC</span>
					<span id="ticking-timecode" class="mono-label">01:25:40:00</span>
				</div>
				<div class="camera-info">
					<span class="mono-label">24FPS</span>
					<span class="mono-label">ISO 400</span>
					<div class="battery-status">
						<span class="mono-label">BAT 88%</span>
						<div class="battery-icon">
							<div class="battery-level"></div>
						</div>
					</div>
				</div>
			</div>
			<nav class="navigation-bar">
				<div class="nav-brand">
					<a href="#" class="brand-link">PORTFOLIO.RAW</a>
				</div>
				<ul class="nav-links">
					<li><a href="#hero" class="nav-link">[01_HOME]</a></li>
					<li><a href="#best-works" class="nav-link">[02_WORKS]</a></li>
					<li><a href="#experience" class="nav-link">[03_TIMELINE]</a></li>
				</ul>
			</nav>
		</header>

		<!-- Main Workspace Content -->
		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="viewfinder-footer">
			<div class="footer-content">
				<div class="footer-left">
					<span class="mono-label">© 2026 portfolio.raw</span>
					<span class="mono-label">ALL RIGHTS RESERVED</span>
				</div>
				<div class="footer-right">
					<ul class="social-links">
						<li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-link">INSTAGRAM</a></li>
						<li><a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-link">YOUTUBE</a></li>
						<li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-link">LINKEDIN</a></li>
						<li><a href="mailto:editor@example.com" class="social-link">EMAIL</a></li>
					</ul>
				</div>
			</div>
		</footer>

		<!-- Timecode ticking script -->
		<script>
			function initTimecode() {
				const timecodeEl = document.getElementById('ticking-timecode');
				if (!timecodeEl) return;

				let hours = 1;
				let minutes = 25;
				let seconds = 40;
				let frames = 0;

				setInterval(() => {
					frames++;
					if (frames >= 24) {
						frames = 0;
						seconds++;
						if (seconds >= 60) {
							seconds = 0;
							minutes++;
							if (minutes >= 60) {
								minutes = 0;
								hours++;
								if (hours >= 24) {
									hours = 0;
								}
							}
						}
					}

					const pad = (num: number) => String(num).padStart(2, '0');
					timecodeEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}:${pad(frames)}`;
				}, 1000 / 24); // 24 fps timecode ticking
			}

			// Run on load and after page transitions (Astro view transitions support if added later)
			initTimecode();
			document.addEventListener('astro:after-swap', initTimecode);
		</script>
	</body>
</html>

<style is:global>
	/* Design Tokens & CSS Variables */
	:root {
		/* Light Mode Colors (desaturated, pastels, high-contrast borders) */
		--bg-color: #f5f2eb;        /* warm cream background */
		--text-color: #1a1a1a;      /* dark charcoal text */
		--border-color: #1a1a1a;    /* solid dark charcoal borders */
		--card-bg: #edeae3;         /* slightly darker cream for elements */
		--accent-color: #c87a68;    /* muted terracotta pastel */
		--pastel-green: #8ba391;    /* desaturated sage green */
		--pastel-yellow: #d6a86c;   /* vintage ochre */
		--pastel-blue: #7d93a4;     /* desaturated slate blue */
		--font-sans: 'Plus Jakarta Sans', sans-serif;
		--font-mono: 'Courier Prime', monospace;
		--border-width: 2px;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* Dark Mode Colors (desaturated, dark charcoal, high-contrast borders) */
			--bg-color: #121314;      /* dark charcoal background */
			--text-color: #e4e4e1;    /* light off-white text */
			--border-color: #e4e4e1;  /* solid light off-white borders */
			--card-bg: #1a1c1d;       /* slightly lighter charcoal for elements */
			--accent-color: #b88a76;  /* desaturated copper/terracotta */
			--pastel-green: #7e9183;  /* desaturated slate/sage green */
			--pastel-yellow: #bda078; /* desaturated vintage ochre */
			--pastel-blue: #6d808e;   /* desaturated navy/slate blue */
		}
	}

	/* Reset and Core Layout */
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		background-color: var(--bg-color);
		color: var(--text-color);
		font-family: var(--font-mono);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow-x: hidden;
	}

	main {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Global Typography */
	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-sans);
		font-weight: 800;
		text-transform: uppercase;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	p {
		line-height: 1.6;
		font-family: var(--font-mono);
		font-size: 0.95rem;
	}

	/* Common Utility UI Classes */
	.mono-label {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.btn-flat {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		background-color: transparent;
		color: var(--text-color);
		border: var(--border-width) solid var(--border-color);
		cursor: pointer;
		transition: all 0.2s steps(4);
		position: relative;
	}

	.btn-flat:hover {
		background-color: var(--text-color);
		color: var(--bg-color);
	}

	.btn-flat:active {
		transform: translate(2px, 2px);
	}

	/* Header Viewfinder Styling */
	.viewfinder-header {
		width: 100%;
		border-bottom: var(--border-width) solid var(--border-color);
		background-color: var(--bg-color);
		z-index: 100;
		position: sticky;
		top: 0;
	}

	.viewfinder-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1.5rem;
		border-bottom: 1px solid var(--border-color);
		opacity: 0.85;
		font-size: 0.8rem;
	}

	.rec-indicator {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.rec-dot {
		width: 10px;
		height: 10px;
		background-color: #ff0000;
		border-radius: 50%;
		animation: rec-blink 1s infinite steps(2);
	}

	.camera-info {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.battery-status {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.battery-icon {
		width: 20px;
		height: 10px;
		border: 1px solid var(--border-color);
		padding: 1px;
		position: relative;
	}

	.battery-icon::after {
		content: '';
		position: absolute;
		right: -3px;
		top: 2px;
		width: 2px;
		height: 4px;
		background-color: var(--border-color);
	}

	.battery-level {
		width: 75%;
		height: 100%;
		background-color: var(--pastel-green);
	}

	.navigation-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 1.5rem;
	}

	.brand-link {
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 1.5rem;
	}

	.nav-link {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.nav-link:hover {
		color: var(--accent-color);
	}

	/* Footer Viewfinder Styling */
	.viewfinder-footer {
		width: 100%;
		margin-top: auto;
		background-color: var(--bg-color);
		border-top: var(--border-width) solid var(--border-color);
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.social-links {
		display: flex;
		list-style: none;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.social-link {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
	}

	.social-link:hover {
		border-bottom-color: var(--border-color);
	}

	/* Animations */
	@keyframes rec-blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	/* Scrollbar Styling */
	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: var(--bg-color);
		border-left: var(--border-width) solid var(--border-color);
	}

	::-webkit-scrollbar-thumb {
		background: var(--border-color);
		border: 2px solid var(--bg-color);
	}

	/* Media Queries */
	@media (max-width: 768px) {
		.viewfinder-top {
			padding: 0.5rem 1rem;
		}
		.camera-info {
			gap: 0.75rem;
		}
		.navigation-bar {
			padding: 0.75rem 1rem;
			flex-direction: column;
			gap: 0.75rem;
		}
		.footer-content {
			padding: 1rem;
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
